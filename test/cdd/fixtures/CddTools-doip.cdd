<ENUMDEF id='_000001A22E3C4F70' oid='66AFDF5B431846e987C257F97E1912FE' temploid='9DF031080C154b54AECE6D726B3D6AC0' attrcatref='_000001A2268D5C80' usage='admin' v='3' sort='id'>
