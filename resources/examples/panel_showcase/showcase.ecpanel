      {
        "id": "html-demo",
        "type": "html",
        "label": "HTML / JS",
        "x": 390,
        "y": 440,
        "width": 730,
        "height": 150,
        "locked": false,
        "fontSize": 14,
        "color": "",
        "unit": "",
        "min": 0,
        "max": 100,
        "step": 1,
        "initialValue": 0,
        "pressValue": 1,
        "releaseValue": 0,
        "toggle": false,
        "readOnly": false,
        "options": [],
        "parentId": "pages",
        "tabId": "styles",
        "htmlContent": "<style>\n.box{height:100%;padding:10px 14px;border:1px solid #409eff;border-radius:6px;background:#ecf5ff;font:13px Consolas,monospace;color:#303133}\n.row{display:flex;align-items:center;gap:10px;height:34px}\n.row span{width:130px;color:#606266}\nstrong{min-width:60px}\nbutton{padding:3px 12px;border:1px solid #409eff;border-radius:4px;background:#fff;color:#409eff;cursor:pointer}\n#msg{color:#f56c6c}\n</style>\n<div class=\"box\">\n<div class=\"row\"><span>DemoFill</span><strong id=\"fill\">--</strong><button data-step=\"-10\">-10</button><button data-step=\"10\">+10</button><button id=\"zero\">0</button></div>\n<div class=\"row\"><span>PanelDemo.Speed</span><strong id=\"speed\">--</strong>km/h</div>\n<div class=\"row\" id=\"msg\"></div>\n</div>",
        "scriptContent": "const $ = (selector) => document.querySelector(selector)\nlet fill = 0\nconst showFill = (value) => {\n  fill = Number(value) || 0\n  $('#fill').textContent = fill + ' %'\n}\nconst setFill = (value) =>\n  panel\n    .setVar('DemoFill', Math.max(0, Math.min(100, value)))\n    .then(() => ($('#msg').textContent = ''))\n    .catch((error) => ($('#msg').textContent = error.message))\npanel.getVar('DemoFill').then(showFill)\npanel.onVar('DemoFill', showFill)\npanel.onSignal('PanelDemo.Speed', (signal) => {\n  $('#speed').textContent = Number(signal.physicalValue).toFixed(1)\n})\ndocument.querySelectorAll('[data-step]').forEach((button) => {\n  button.onclick = () => setFill(fill + Number(button.dataset.step))\n})\n$('#zero').onclick = () => setFill(0)"
      }
    ]
  }
}