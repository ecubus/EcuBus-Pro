<UNSDEF id='_000001A22E4642D0' oid='E8FDDD2DC2954062B987E58FBFECC5B2' temploid='170235BB46F547f2878AF3DE9B199D35' attrcatref='_000001A2268D5C80' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
<TUV xml:lang='zh-HANS' uptodate='0'></TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
<TUV xml:lang='zh-HANS' uptodate='0'></TUV>
</DESC>
<QUAL>CAN_FD_Extended_Addressing.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001A22E493250' oid='BE98AF16CD024b719278DE3FE91753C3' temploid='116DF67168C64373BCB78660F0F5210A' attrcatref='_000001A2268D5C80' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
<TUV xml:lang='zh-HANS' uptodate='0'></TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses. The response for functional requests is sent via the physical path.</TUV>
<TUV xml:lang='zh-HANS' uptodate='0'></TUV>
</DESC>
<QUAL>CAN_FD_Extended_Addressing.ResCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001A22E496C70' oid='5ACB552895B2451bBD4333E441720163' temploid='21B27347E6ED4e9aB36E1F37DBAD27F6' attrcatref='_000001A2268D5C80' usage='admin' v='1' df='hex'>
